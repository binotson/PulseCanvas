# PulseCanvas configuration (development only)
#
# Copy this file to `.env` in the project root and fill in your key:
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (PowerShell)
#
# `.env` is git-ignored. It is read at runtime by the Electron MAIN process
# only, and only in development (unpackaged) builds. It is never bundled into
# the app and never sent to the renderer.
#
# Packaged builds: enter the key in Settings → SmartSpectra API key instead.
# It is then encrypted with the OS keychain (Electron safeStorage / Windows DPAPI)
# and stored in the app's user-data directory.

# Your SmartSpectra API key from https://physiology.presagetech.com/auth/login
SMARTSPECTRA_API_KEY=

# Optional: set to 1 to print SmartSpectra SDK IPC diagnostics to the console.
# SMARTSPECTRA_DIAGNOSTICS=0
