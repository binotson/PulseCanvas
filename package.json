{
  "name": "pulsecanvas",
  "productName": "PulseCanvas",
  "version": "0.1.0",
  "description": "Turn your live pulse and breathing — measured from your webcam by Presage SmartSpectra — into generative art.",
  "main": "./out/main/index.js",
  "author": "PulseCanvas contributors",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/binotson/PulseCanvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binotson/PulseCanvas.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && electron-vite build",
    "sdk:check": "node scripts/sdk-check.cjs",
    "smoke": "electron-vite build && node scripts/smoke.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.7",
    "electron-builder": "^26.6.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  }
}
